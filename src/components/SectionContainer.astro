---
interface Props {
  id?: string;
  hasBorderTop?: boolean;
  class?: string;
}

const {
  id,
  hasBorderTop = true,
  class: className = '',
} = Astro.props;
---

<section
  id={id}
  class={`shell py-16 lg:py-20 ${
    hasBorderTop ? 'border-t border-slate-200 dark:border-slate-800' : ''
  } ${className}`}
>
  <slot />
</section>
