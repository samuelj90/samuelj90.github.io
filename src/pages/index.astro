---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import SectionContainer from '../components/SectionContainer.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TimelineItem from '../components/TimelineItem.astro';
import SkillBadge from '../components/SkillBadge.astro';
import Button from '../components/Button.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { formatDate, isoDate } from '../utils/date';
import Container from '../components/Container.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Samuel J Mathew | Senior Software Engineer • Technical Architect"
  description="Senior Software Engineer and Technical Architect specializing in high-scale distributed backends, AI-native automation, and resilient cross-platform systems."
>
  <Navbar />

  <main>
    <!-- Hero Section -->
    <Container as="section" class="flex flex-col items-center justify-center text-center pt-16 sm:pt-20 pb-12 sm:pb-16 animate-fade-in">
      <!-- Profile Avatar (without extraneous pill or badge) -->
      <div class="relative mb-6">
        <div class="w-32 h-32 sm:w-36 sm:h-36 rounded-full p-1 bg-gradient-to-tr from-teal-500 via-teal-600 to-cyan-500 ring-4 ring-teal-100 dark:ring-teal-900/50 shadow-xl">
          <img
            src="/assets/images/profile.png"
            alt="Samuel J Mathew"
            class="w-full h-full rounded-full object-cover bg-white dark:bg-slate-900"
          />
        </div>
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight mb-3 font-display text-balance">
        Samuel J Mathew
      </h1>

      <p class="text-xl sm:text-2xl md:text-3xl font-semibold bg-gradient-to-r from-teal-600 via-teal-500 to-cyan-500 dark:from-teal-400 dark:via-teal-300 dark:to-cyan-400 bg-clip-text text-transparent mb-4 text-balance">
        Senior Software Engineer • Technical Architect
      </p>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed mb-8 text-balance">
        Focused on distributed microservices, event streaming at scale, and AI agent engineering. Passionate about clean architecture, deterministic verification, and developer tooling.
      </p>

      <div class="flex flex-wrap gap-3.5 justify-center items-center">
        <a
          href="#projects"
          class="px-6 py-3 rounded-lg bg-teal-600 hover:bg-teal-700 text-white font-medium shadow-xs transition-all duration-200 hover:shadow flex items-center gap-2 text-sm sm:text-base focus:ring-2 focus:ring-teal-500 focus:outline-hidden"
        >
          View Flagship Systems
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </a>

        <a
          href="https://linkedin.com/in/samuelj90"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 hover:border-slate-400 dark:hover:border-slate-600 text-slate-700 dark:text-slate-200 hover:text-slate-900 dark:hover:text-white font-medium transition-all duration-200 text-sm sm:text-base flex items-center gap-2 focus:ring-2 focus:ring-teal-500 focus:outline-hidden"
        >
          <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          Resume on LinkedIn
        </a>

        <a
          href="#contact"
          class="px-6 py-3 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-medium transition-all duration-200 text-sm sm:text-base focus:ring-2 focus:ring-teal-500 focus:outline-hidden"
        >
          Let's Talk
        </a>
      </div>
    </Container>

    <!-- Core Engineering Focus & Architectural Domains (Stretched to match heights, gap filled) -->
    <Container as="section" class="py-8 sm:py-12">
      <div class="grid lg:grid-cols-2 gap-8 items-stretch">
        <!-- Card 1: Core Competencies -->
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-xs hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 rounded-lg bg-teal-50 dark:bg-teal-950/60 text-teal-600 dark:text-teal-400 flex items-center justify-center font-bold">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
              </div>
              <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-teal-600 dark:text-teal-400 font-mono">Production Capabilities</span>
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white font-display">Areas of Expertise</h2>
              </div>
            </div>
            <!-- Two-column filled layout with one-line descriptors -->
            <div class="grid sm:grid-cols-2 gap-3 text-sm">
              <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 flex flex-col">
                <span class="font-semibold text-slate-900 dark:text-white flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-teal-500"></span> Distributed Microservices</span>
                <span class="text-xs text-slate-500 dark:text-slate-400 mt-1">High-throughput Kafka & Spring Boot</span>
              </div>
              <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 flex flex-col">
                <span class="font-semibold text-slate-900 dark:text-white flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-teal-500"></span> Event-Driven Streaming</span>
                <span class="text-xs text-slate-500 dark:text-slate-400 mt-1">Sub-second pub/sub messaging</span>
              </div>
              <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 flex flex-col">
                <span class="font-semibold text-slate-900 dark:text-white flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-teal-500"></span> Cloud-Native Infra</span>
                <span class="text-xs text-slate-500 dark:text-slate-400 mt-1">Kubernetes, Docker, automated GitOps</span>
              </div>
              <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 flex flex-col">
                <span class="font-semibold text-slate-900 dark:text-white flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-teal-500"></span> AI Agent Engineering</span>
                <span class="text-xs text-slate-500 dark:text-slate-400 mt-1">Model Context Protocol (MCP) systems</span>
              </div>
              <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 flex flex-col">
                <span class="font-semibold text-slate-900 dark:text-white flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-teal-500"></span> High-Frequency Trading</span>
                <span class="text-xs text-slate-500 dark:text-slate-400 mt-1">Fault-tolerant order routing engines</span>
              </div>
              <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 flex flex-col">
                <span class="font-semibold text-slate-900 dark:text-white flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-teal-500"></span> Enterprise Frontends</span>
                <span class="text-xs text-slate-500 dark:text-slate-400 mt-1">Micro-frontends & Module Federation</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 2: Strategic Technical Focus -->
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-xs hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 rounded-lg bg-teal-50 dark:bg-teal-950/60 text-teal-600 dark:text-teal-400 flex items-center justify-center font-bold">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
              </div>
              <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-teal-600 dark:text-teal-400 font-mono">Architectural Horizon</span>
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white font-display">Specialized Domains</h2>
              </div>
            </div>
            <div class="space-y-3 text-sm">
              <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
                <span class="font-semibold text-slate-900 dark:text-white">JVM & Enterprise Runtime</span>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Spring Boot 3, Java 21, virtual threads, low-latency concurrent processing.</p>
              </div>
              <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
                <span class="font-semibold text-slate-900 dark:text-white">Modern TypeScript & React</span>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Strict type systems, reactive state synchronization, and high-performance Web Components.</p>
              </div>
              <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
                <span class="font-semibold text-slate-900 dark:text-white">Kubernetes & Cloud DevOps</span>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Declarative container orchestration, multi-cluster ingress, and automated CI quality gates.</p>
              </div>
              <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
                <span class="font-semibold text-slate-900 dark:text-white">Zero-Trust & Cryptography</span>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Secure token lifecycle, authenticated encryption (AES-256), and security boundaries.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>

    <!-- Featured Architecture & Flagship Projects Section -->
    <SectionContainer id="projects">
      <SectionHeader
        eyebrow="Engineering Portfolio"
        title="Featured Architecture & Systems"
        description="Selected open-source production architectures, AI-native platforms, and developer systems engineered with clean design, automated quality gates, and high reliability."
      />

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map((project) => <ProjectCard project={project.data} />)}
      </div>
    </SectionContainer>

    <!-- Skills Section (Restored Original 7 Categorized Groups with High-Quality Shields) -->
    <SectionContainer id="skills">
      <SectionHeader
        eyebrow="Toolbox"
        title="Technical Skills & Stack"
        description="Core languages, frontend and backend frameworks, databases, build tools, and cloud platforms engineered for production stability."
      />

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        <!-- Programming Languages -->
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6 shadow-xs hover:shadow-md transition-all duration-300 hover:-translate-y-0.5">
          <h3 class="font-bold text-lg mb-4 text-slate-800 dark:text-slate-100 flex items-center">
            <span class="mr-2 text-amber-500">⚡</span>Programming Languages
          </h3>
          <div class="flex flex-wrap gap-2">
            <SkillBadge name="Java" logo="openjdk" />
            <SkillBadge name="JavaScript" logo="javascript" color="F7DF1E" />
            <SkillBadge name="PHP" logo="php" color="777BB4" />
            <SkillBadge name="HTML" logo="html5" color="E34F26" />
            <SkillBadge name="CSS" logo="css3" color="1572B6" />
          </div>
        </div>

        <!-- Frontend Frameworks -->
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6 shadow-xs hover:shadow-md transition-all duration-300 hover:-translate-y-0.5">
          <h3 class="font-bold text-lg mb-4 text-slate-800 dark:text-slate-100 flex items-center">
            <span class="mr-2 text-cyan-500">🎨</span>Frontend Frameworks
          </h3>
          <div class="flex flex-wrap gap-2">
            <SkillBadge name="React" logo="react" color="61DAFB" />
            <SkillBadge name="Redux" logo="redux" color="764ABC" />
            <SkillBadge name="Material UI" logo="mui" color="007FFF" />
            <SkillBadge name="Angular" logo="angular" color="DD0031" />
            <SkillBadge name="NgRx" logo="ReactiveX" />
            <SkillBadge name="Bootstrap" logo="bootstrap" color="563D7C" />
          </div>
        </div>

        <!-- Backend Frameworks -->
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6 shadow-xs hover:shadow-md transition-all duration-300 hover:-translate-y-0.5">
          <h3 class="font-bold text-lg mb-4 text-slate-800 dark:text-slate-100 flex items-center">
            <span class="mr-2 text-emerald-500">🔧</span>Backend Frameworks
          </h3>
          <div class="flex flex-wrap gap-2">
            <SkillBadge name="Spring" logo="spring" />
            <SkillBadge name="Laravel" logo="Laravel" />
            <SkillBadge name="Codeigniter" logo="Codeigniter" />
            <SkillBadge name="Node.js" logo="node.js" />
            <SkillBadge name="Express" logo="express" />
          </div>
        </div>

        <!-- Databases -->
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6 shadow-xs hover:shadow-md transition-all duration-300 hover:-translate-y-0.5">
          <h3 class="font-bold text-lg mb-4 text-slate-800 dark:text-slate-100 flex items-center">
            <span class="mr-2 text-indigo-500">🗄️</span>Databases
          </h3>
          <div class="flex flex-wrap gap-2">
            <SkillBadge name="Oracle" logo="oracle" />
            <SkillBadge name="PostgreSQL" logo="PostgreSQL" />
            <SkillBadge name="MySQL" logo="MySQL" />
            <SkillBadge name="MSSQL" logo="mssql" />
            <SkillBadge name="MongoDB" logo="Mongodb" />
          </div>
        </div>

        <!-- Build Tools -->
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6 shadow-xs hover:shadow-md transition-all duration-300 hover:-translate-y-0.5">
          <h3 class="font-bold text-lg mb-4 text-slate-800 dark:text-slate-100 flex items-center">
            <span class="mr-2 text-orange-500">🔨</span>Build Tools
          </h3>
          <div class="flex flex-wrap gap-2">
            <SkillBadge name="Gradle" logo="Gradle" />
            <SkillBadge name="Maven" logo="Apache Maven" />
            <SkillBadge name="Webpack" logo="Webpack" />
            <SkillBadge name="Gulp" logo="Gulp" />
            <SkillBadge name="Grunt" logo="Grunt" />
          </div>
        </div>

        <!-- DevOps & Source Control -->
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6 shadow-xs hover:shadow-md transition-all duration-300 hover:-translate-y-0.5">
          <h3 class="font-bold text-lg mb-4 text-slate-800 dark:text-slate-100 flex items-center">
            <span class="mr-2 text-rose-500">🚀</span>DevOps & Source Control
          </h3>
          <div class="flex flex-wrap gap-2">
            <SkillBadge name="Git" logo="Git" />
            <SkillBadge name="SVN" logo="subversion" />
            <SkillBadge name="Docker" logo="Docker" />
            <SkillBadge name="Kubernetes" logo="Kubernetes" />
            <SkillBadge name="Jenkins" logo="Jenkins" />
            <SkillBadge name="GitLab" logo="Gitlab" />
            <SkillBadge name="GitHub" logo="Github" />
          </div>
        </div>

        <!-- CMS & Cloud Platforms (spans full width on lg screens) -->
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6 shadow-xs hover:shadow-md transition-all duration-300 hover:-translate-y-0.5 lg:col-span-3">
          <h3 class="font-bold text-lg mb-4 text-slate-800 dark:text-slate-100 flex items-center justify-center">
            <span class="mr-2 text-sky-500">☁️</span>CMS & Cloud Platforms
          </h3>
          <div class="flex flex-wrap gap-2 justify-center">
            <SkillBadge name="Adobe AEM" logo="adobe" />
            <SkillBadge name="WordPress" logo="Wordpress" />
            <SkillBadge name="AWS" logo="amazon-aws" />
            <SkillBadge name="Azure" logo="azure-devops" />
            <SkillBadge name="GCP" logo="google-cloud" />
            <SkillBadge name="Heroku" logo="heroku" />
          </div>
        </div>
      </div>
    </SectionContainer>

    <!-- Professional Journey Timeline -->
    <SectionContainer id="timeline">
      <SectionHeader
        eyebrow="Career Trajectory"
        title="Professional Journey"
        description="Over 12 years of hands-on technical leadership, architecting mission-critical enterprise systems and driving software craftsmanship."
      />

      <!-- Timeline Milestone List -->
      <div class="max-w-4xl relative pl-6 sm:pl-8 border-l-2 border-slate-200 dark:border-slate-800 ml-4 sm:ml-8 space-y-10">
        <!-- Milestone 1 -->
        <TimelineItem
          title="Senior Software Engineer"
          subtitle="Emirates Airlines"
          date="Dec 2022 – Present"
          isCurrent={true}
          description="Architecting and engineering high-availability airline core systems, customer booking workflows, and mission-critical cloud integrations serving millions of passengers globally."
          impact="Zero-downtime flight operations integrations handling high concurrent loads."
          tags={["Enterprise Java", "Microservices", "Cloud Architecture", "Spring Boot", "Kafka"]}
        />

        <!-- Milestone 2 -->
        <TimelineItem
          title="Senior Software Engineer"
          subtitle="Nissan Digital Hub"
          date="Jun 2020 – Nov 2022"
          description="Engineered connected vehicle platforms, cloud microservices, and global digital initiatives. Spearheaded UI modernization and automated CI/CD deployment pipelines."
          impact="Standardized deployment automation across global regional vehicle portals."
          tags={["Connected Vehicles", "React & Node", "Kubernetes", "TypeScript", "Microservices"]}
        />

        <!-- Milestone 3 -->
        <TimelineItem
          title="Technical Architect"
          subtitle="Geojit Technologies"
          date="May 2019 – May 2020"
          description="Designed real-time financial trading engines, multi-tier security boundaries, and high-frequency market data streaming systems with strict regulatory compliance."
          impact="High-throughput trade order routing engine with sub-millisecond execution times."
          tags={["FinTech & Trading", "High-Throughput IO", "System Architecture", "Zero-Trust Security"]}
        />

        <!-- Milestone 4 -->
        <TimelineItem
          title="Senior Software Engineer"
          subtitle="Geojit Technologies"
          date="Sep 2016 – May 2019"
          description="Delivered enterprise retail trading platforms, mobile brokerage backend APIs, and distributed caching layers for fault-tolerant execution."
          impact="Scaled mobile brokerage API throughput by 3x during peak market market hours."
          tags={["Java Enterprise", "Spring Boot", "REST APIs", "Distributed Caching"]}
        />

        <!-- Milestone 5 (Consistent Role · Company / Degree · Institution Pattern) -->
        <TimelineItem
          title="B.Tech in Information Technology"
          subtitle="Engineering Graduate"
          date="Jul 2008 – Aug 2012"
          description="Foundational degree in Computer Science, Distributed Systems, Data Structures & Algorithms, Network Protocols, and Operating Systems."
          tags={["Computer Science", "Algorithms", "Network Protocols", "Distributed Systems"]}
        />
      </div>
    </SectionContainer>

    <!-- Engineering Blog & Technical Notes -->
    <SectionContainer id="blog">
      <SectionHeader
        eyebrow="Knowledge Sharing"
        title="Technical Blog"
        description="In-depth architectural breakdowns, AI engineering benchmarks, distributed system design, and production post-mortems."
      >
        <Button href="/blog" variant="secondary" slot="action">
          Browse All Articles →
        </Button>
      </SectionHeader>

      <div class="grid md:grid-cols-3 gap-8">
        {posts.map((post) => {
          return (
            <article class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6 shadow-xs hover:shadow-md transition-all flex flex-col group">
              <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 mb-3">
                <span class="px-2.5 py-1 rounded-full bg-teal-50 dark:bg-teal-950/80 text-teal-800 dark:text-teal-300 border border-transparent dark:border-teal-800/60 font-medium">
                  {post.data.category}
                </span>
                <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
              </div>
              <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors mb-2 font-display">
                {post.data.title}
              </h3>
              <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4 flex-1">
                {post.data.description}
              </p>
              <div class="flex items-baseline justify-between pt-4 border-t border-slate-900/[0.07] dark:border-white/[0.07] text-xs text-slate-500 dark:text-slate-400">
                <span>{post.data.readingTime || '5 min read'}</span>
                <a href={`/blog/${post.id}`} class="font-semibold text-teal-600 dark:text-teal-400 hover:text-teal-700 dark:hover:text-teal-300 transition-colors">
                  Read Article →
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </SectionContainer>

    <!-- GitHub Stats & Contact Section ("Let's talk") -->
    <SectionContainer id="contact">
      <SectionHeader
        eyebrow="Collaboration & Outreach"
        title="Let's Talk"
        description="Open to architecture consulting, senior engineering roles, and open-source collaboration."
      />

      <!-- Theme-Aware GitHub Engineering Snapshot (Fixed overlapping dots, same tokens) -->
      <div class="bg-white dark:bg-slate-900 rounded-xl p-6 sm:p-8 shadow-xs mb-12 border border-slate-200 dark:border-slate-800 transition-colors max-w-5xl">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-4 mb-6">
          <div class="flex items-center gap-2">
            <!-- Terminal title bar dots -->
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-red-400 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-amber-400 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-400 inline-block"></span>
            </div>
            <span class="text-xs text-slate-500 dark:text-slate-400 font-mono ml-2">github.com/samuelj90 • profile stats</span>
          </div>
          <span class="text-xs bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 px-2.5 py-1 rounded-md font-mono">
            GitHub metrics
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 text-center">
