---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import GistInline from '../../components/GistInline.astro';
import MermaidRenderer from '../../components/MermaidRenderer.astro';
import { processBlogContent } from '../../utils/gist';
import { formatDate, isoDate } from '../../utils/date';
import { getCollection, render } from 'astro:content';
import Container from '../../components/Container.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const rendered = await render(post);
const { Content } = rendered;
const postHtml = post.rendered?.html ? await processBlogContent(post.rendered.html) : null;

const isProductArticle = post.data.category === 'Product Architecture' || post.data.tags.includes('Product Showcase');

// Product Article Schema vs Tech Article Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": isProductArticle ? "SoftwareApplication" : "TechArticle",
  "headline": post.data.title,
  "name": post.data.title,
  "description": post.data.description,
  "author": {
    "@type": "Person",
    "name": "Samuel J Mathew",
    "url": "https://samuelj90.github.io"
  },
  "datePublished": isoDate(post.data.date),
  "applicationCategory": isProductArticle ? "DeveloperApplication" : undefined,
  "operatingSystem": isProductArticle ? "Cross-platform" : undefined
};
---

<BaseLayout
  title={`${post.data.title} • Samuel J Mathew`}
  description={post.data.description}
  type="article"
>
  <!-- Injected SEO Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />

  <Navbar />

  <Container as="article" class="py-12 sm:py-16">
    <div class="mb-10 max-w-3xl">
      <div class="flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400 mb-3">
        <span class={`px-2.5 py-1 rounded-full font-semibold border ${
          isProductArticle
            ? 'bg-purple-50 dark:bg-purple-950/80 text-purple-800 dark:text-purple-300 border-purple-200 dark:border-purple-800/60'
            : 'bg-teal-50 dark:bg-teal-950/80 text-teal-800 dark:text-teal-300 border-teal-200 dark:border-teal-800/60'
        }`}>
          {post.data.category}
        </span>
        <span>•</span>
        <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
        {post.data.readingTime && (
          <>
            <span>•</span>
            <span>{post.data.readingTime}</span>
          </>
        )}
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight font-display mb-4">
        {post.data.title}
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed font-medium">
        {post.data.description}
      </p>
    </div>

    <div class="prose max-w-none text-slate-700 dark:text-slate-300 space-y-6 leading-relaxed">
      {postHtml ? (
        <Fragment set:html={postHtml} />
      ) : (
        <Content components={{ GistInline, GistEmbed: GistInline }} />
      )}
    </div>

    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 mt-12 flex items-center justify-between">
      <a href="/blog" class="text-sm font-semibold text-teal-600 dark:text-teal-400 hover:underline">
        ← Back to All Articles
      </a>
      <a href="/#contact" class="text-sm font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">
        Discuss Product →
      </a>
    </div>
  </Container>

  <MermaidRenderer />
</BaseLayout>
